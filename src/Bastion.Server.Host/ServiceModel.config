<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <system.serviceModel>
        <bindings>
            <netTcpBinding>
                <binding name="SecureNetTcp"
                         receiveTimeout="00:30:00"
                         sendTimeout="00:01:00">
                    <security mode="Transport">
                        <transport clientCredentialType="None" />
                    </security>
                </binding>
                <!-- The client sends a keep-alive every minute, so three minutes of silence means it is gone (CU-09 EX-04). -->
                <!-- A callback to a frozen client must not hold the chat broadcast or the matchmaking review for a minute. -->
                <binding name="NotificationNetTcp"
                         receiveTimeout="00:03:00"
                         sendTimeout="00:00:10">
                    <security mode="Transport">
                        <transport clientCredentialType="None" />
                    </security>
                </binding>
            </netTcpBinding>
        </bindings>
        <services>
            <service name="Bastion.Server.Host.Accounts.AccountService">
                <endpoint address="/accounts"
                          binding="netTcpBinding"
                          bindingConfiguration="SecureNetTcp"
                          contract="Bastion.Contracts.Accounts.IAccountService" />
            </service>
            <service name="Bastion.Server.Host.Sessions.SessionService">
                <endpoint address="/sessions"
                          binding="netTcpBinding"
                          bindingConfiguration="NotificationNetTcp"
                          contract="Bastion.Contracts.Sessions.ISessionService" />
            </service>
            <service name="Bastion.Server.Host.Chat.ChatService">
                <endpoint address="/chat"
                          binding="netTcpBinding"
                          bindingConfiguration="SecureNetTcp"
                          contract="Bastion.Contracts.Chat.IChatService" />
            </service>
            <service name="Bastion.Server.Host.Matchmaking.MatchmakingService">
                <endpoint address="/matchmaking"
                          binding="netTcpBinding"
                          bindingConfiguration="SecureNetTcp"
                          contract="Bastion.Contracts.Matchmaking.IMatchmakingService" />
            </service>
            <service name="Bastion.Server.Host.Friends.FriendshipService">
                <endpoint address="/friends"
                          binding="netTcpBinding"
                          bindingConfiguration="SecureNetTcp"
                          contract="Bastion.Contracts.Friends.IFriendshipService" />
            </service>
            <service name="Bastion.Server.Host.PrivateChat.ConversationService">
                <endpoint address="/conversations"
                          binding="netTcpBinding"
                          bindingConfiguration="SecureNetTcp"
                          contract="Bastion.Contracts.PrivateChat.IConversationService" />
            </service>
        </services>
    </system.serviceModel>
</configuration>
