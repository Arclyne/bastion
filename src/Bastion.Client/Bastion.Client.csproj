<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <RollForward>Major</RollForward>
        <PublishReadyToRun>false</PublishReadyToRun>
        <TieredCompilation>false</TieredCompilation>
        <Version>0.1.0</Version>
        <NeutralLanguage>en-US</NeutralLanguage>
        <SatelliteResourceLanguages>es-MX</SatelliteResourceLanguages>
    </PropertyGroup>

    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Icon.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="Icon.ico" />
        <None Remove="Icon.bmp" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Icon.ico">
            <LogicalName>Icon.ico</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Icon.bmp">
            <LogicalName>Icon.bmp</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Localization\Strings.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Strings.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <Compile Update="Localization\Strings.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Strings.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MonoGame.Framework.DesktopGL" />
        <PackageReference Include="MonoGame.Content.Builder.Task" />
        <PackageReference Include="Gum.MonoGame" />
        <PackageReference Include="Gum.Shapes.MonoGame" />
        <PackageReference Include="KernSmith.MonoGameGum" />
        <PackageReference Include="log4net" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Content\Fonts\**" CopyToOutputDirectory="PreserveNewest" />
        <None Update="log4net.config" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bastion.Client.Networking\Bastion.Client.Networking.csproj" />
        <ProjectReference Include="..\Bastion.Domain\Bastion.Domain.csproj" />
    </ItemGroup>

</Project>
